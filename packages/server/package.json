{
  "name": "openspecui",
  "version": "0.1.0",
  "description": "Local multi-workspace visual workbench and read-only Git companion for OpenSpec",
  "type": "module",
  "bin": {
    "openspecui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts --dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "@openspecui/shared": "*",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
